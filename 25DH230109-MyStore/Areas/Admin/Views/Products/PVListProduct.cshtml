@model _25DH230109_MyStore.Models.ViewModel.ProductSearchVM
@using PagedList.Mvc
@{
    var pagingValues = new System.Web.Routing.RouteValueDictionary {
        { "keyword", Model.Keyword }, { "minPrice", Model.MinPrice },
        { "maxPrice", Model.MaxPrice }, { "sortOrder", Model.SortOrder }
    };
}
<table class="table table-striped table-bordered">
    <thead class="table-success">
        <tr>
            <th>Tên sản phẩm</th>
            <th>Hình ảnh</th>
            <th>Đơn giá</th>
            <th>Danh mục</th>
            <th>Mô tả</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
    @if (Model.Products != null && Model.Products.Any())
    {
        foreach (var item in Model.Products)
        {
            <tr>
                <td>@item.ProductName</td>
                <td><img class="product-image" src="@Url.Content(string.IsNullOrWhiteSpace(item.ProductImage) ? "~/Content/images/no-image.svg" : item.ProductImage)" alt="@item.ProductName" /></td>
                <td>@item.ProductPrice.ToString("N0")</td>
                <td>@(item.Category == null ? "" : item.Category.CategoryName)</td>
                <td>@item.ProductDescription</td>
                <td>
                    @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" })
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-info btn-sm" })
                    @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    }
    else
    {
        <tr><td colspan="6" class="text-center">Không tìm thấy sản phẩm phù hợp.</td></tr>
    }
    </tbody>
</table>
@if (Model.Products != null && Model.Products.PageCount > 1)
{
    <div class="text-center">
        Trang @(Model.Products.PageCount < Model.Products.PageNumber ? 0 : Model.Products.PageNumber) / @Model.Products.PageCount
        @Html.PagedListPager(Model.Products, page => Url.Action("Index", new {
            page, keyword = Model.Keyword, minPrice = Model.MinPrice,
            maxPrice = Model.MaxPrice, sortOrder = Model.SortOrder
        }))
    </div>
}
