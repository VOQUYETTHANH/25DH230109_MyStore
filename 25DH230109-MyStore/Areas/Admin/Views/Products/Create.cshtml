@model _25DH230109_MyStore.Models.Product
@{
    Layout = null;
    ViewBag.Title = "Thêm sản phẩm";
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    @Styles.Render("~/Content/css")
</head>
<body class="container">
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
    <h2 class="text-bg-success p-2">Thêm sản phẩm</h2>
    @using (Html.BeginForm("Create", "Products", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.Partial("PVCreateEditProduct", Model)
    }
    <p>@Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary" })</p>
</body>
</html>
